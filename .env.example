# Aurora QualityOps AI — copy to .env and keep real values local.
HOST=127.0.0.1
PORT=5000

# Empty key = rule-based analysis. Never commit a real API key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Optional. Default database: instance/qualityops.db
# QUALITYOPS_DATABASE_URL=sqlite:///instance/separate-demo.db
# SESSION_SECRET=
